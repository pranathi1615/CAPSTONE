# CareBridge Environment Variables
ENVIRONMENT=development
DEBUG=true

# MongoDB Configuration (Replica Set rs0)
MONGO_URI=mongodb://localhost:27017/?replicaSet=rs0&directConnection=true
MONGO_DB_NAME=carebridge

# Redis Configuration
REDIS_URL=redis://localhost:6379/0

# Security (JWT Auth)
JWT_SECRET_KEY=carebridge-super-secret-key-change-in-production-min32chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Rate Limiting
RATE_LIMIT_LOGIN_ATTEMPTS=10
RATE_LIMIT_LOGIN_WINDOW_SECONDS=60
RATE_LIMIT_REGISTER_ATTEMPTS=10
RATE_LIMIT_REGISTER_WINDOW_SECONDS=60

# Frontend API URL
VITE_API_BASE_URL=http://localhost:8000
